*.py[cod]
*.egg-info/
.venv/
dist/
build/

# 环境与密钥
.env
.env.local

# 数据与产物（体积大，不入库；通过脚本重新生成）
data/*.duckdb
data/*.duckdb.wal
data/raw/
data/filtered/
data/embed-cache/
htmlcov/
.coverage
.pytest_cache/
.ruff_cache/

